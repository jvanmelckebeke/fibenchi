# Dependencies are installed inside the image (deps stage). Never ship the host's
# node_modules into the build context — it clobbers the clean install via `COPY . .`
# and can be a stale, wrong-arch, or root-owned tree.
node_modules
.pnpm-store

# Build output — regenerated by `pnpm build` inside the image.
dist

# Local/editor cruft that has no place in the image.
*.log
.DS_Store
.vscode
.idea
Dockerfile
.dockerignore
